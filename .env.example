# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking page (Cal.com, Calendly, SavvyCal... anything embeddable in an iframe)
NEXT_PUBLIC_BOOKING_URL=https://cal.com/tobi-oyinlola-cesd2w/30min

# Public contact email shown in "Copy email" / mailto
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery uses FormSubmit (no key needed). Optional: override the recipient (defaults to the site email).
CONTACT_TO_EMAIL=

# Optional spam protection (Cloudflare Turnstile). Honeypot + time-trap run regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
