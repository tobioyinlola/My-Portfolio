# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking page (Cal.com, Calendly, SavvyCal... anything embeddable in an iframe)
NEXT_PUBLIC_BOOKING_URL=

# Public contact email shown in "Copy email" / mailto
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery (Resend). Without these the form tells visitors to email you.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional spam protection (Cloudflare Turnstile). Honeypot + time-trap run regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
