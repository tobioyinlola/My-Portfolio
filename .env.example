# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Booking page (Cal.com, Calendly, SavvyCal... anything embeddable in an iframe)
NEXT_PUBLIC_BOOKING_URL=https://cal.com/tobi-oyinlola-cesd2w/30min

# Public contact email shown in "Copy email" / mailto
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery (Resend). Only RESEND_API_KEY is required.
# Sign up to Resend with the SAME email you want messages sent to (the shared sender only delivers to your own account email).
# Optional: CONTACT_TO_EMAIL (defaults to the site email) and CONTACT_FROM_EMAIL (defaults to onboarding@resend.dev;
# set to e.g. "Portfolio <hello@yourdomain.com>" once your domain is verified in Resend).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional spam protection (Cloudflare Turnstile). Honeypot + time-trap run regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
